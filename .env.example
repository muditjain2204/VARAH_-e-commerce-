# ===========================================
# Varah Store — Environment Variables
# ===========================================
# Copy this file to .env and fill in values

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://user:password@localhost:5432/varah_store?schema=public"

# ---- Clerk Authentication ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ---- Cloudinary ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Razorpay (Payments & Webhooks) ----
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---- Shiprocket (Phase 5) ----
SHIPROCKET_EMAIL=your_email
SHIPROCKET_PASSWORD=your_password

# ---- Admin Portal OTP Authentication ----
ADMIN_PHONE=9876543210
ADMIN_MASTER_OTP=999999
FAST2SMS_API_KEY=your_fast2sms_dev_api_key_here

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
