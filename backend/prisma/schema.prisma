// VARAH Multi-Vendor Marketplace — Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========== ENUMS ==========

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum ProductStatus {
  PENDING
  ACTIVE
  REJECTED
  DRAFT
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  COD
  NETBANKING
  WALLET
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

// ========== MODELS ==========

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
  seller       Seller?

  @@map("users")
}

model Seller {
  id              String       @id @default(cuid())
  userId          String       @unique
  shopName        String
  description     String?
  gstin           String?
  enrolmentId     String?      // For non-GST intra-state sellers (Meesho style)
  pan             String
  status          SellerStatus @default(PENDING)
  commissionRate  Float        @default(15.0) // Platform takes 15%
  bankAccountName String?
  bankAccount     String?
  ifsc            String?
  panImage        String?      // KYC Document
  gstinImage      String?      // KYC Document
  cancelledCheque String?      // KYC Document
  shopAddress     String?
  city            String?
  state           String?
  pincode         String?
  category        String?      // Primary category
  rating          Float        @default(0)
  totalSales      Int          @default(0)
  totalRevenue    Float        @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  products        Product[]
  orderItems      OrderItem[]

  @@map("sellers")
}

model Address {
  id          String      @id @default(cuid())
  userId      String
  fullName    String
  phone       String
  addressLine String
  locality    String?
  landmark    String?
  city        String
  state       String
  pincode     String
  type        AddressType @default(HOME)
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@map("addresses")
}

model Product {
  id            String        @id @default(cuid())
  sellerId      String
  name          String
  slug          String        @unique
  description   String
  price         Float
  originalPrice Float?
  discount      Int?          // percentage
  stockCount    Int           @default(0)
  category      String
  subcategory   String?
  fabric        String?
  work          String?
  occasion      String?
  color         String?
  weight        String?
  length        String?       // For sarees
  blousePiece   String?       // For sarees
  components    String?       // For lehengas
  size          String?
  washCare      String?
  images        String[]      // Array of image URLs
  tags          String[]      // bestseller, handwoven, trending, etc.
  status        ProductStatus @default(PENDING)
  rating        Float         @default(0)
  reviewCount   Int           @default(0)
  viewCount     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  seller        Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistedBy  WishlistItem[]

  @@index([category])
  @@index([sellerId])
  @@index([status])
  @@index([price])
  @@map("products")
}

model Order {
  id            String        @id @default(cuid())
  userId        String
  addressId     String
  status        OrderStatus   @default(PLACED)
  subtotal      Float
  shipping      Float         @default(0)
  codCharge     Float         @default(0)
  discount      Float         @default(0)
  total         Float
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  razorpayId    String?       // Razorpay order/payment ID
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user          User          @relation(fields: [userId], references: [id])
  address       Address       @relation(fields: [addressId], references: [id])
  items         OrderItem[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String            @id @default(cuid())
  orderId             String
  productId           String
  sellerId            String
  quantity            Int
  priceAtPurchase     Float             // Snapshot of price
  sellerPayout        Float             // Amount seller receives
  platformCommission  Float             // Amount VARAH keeps
  fulfillmentStatus   FulfillmentStatus @default(PENDING)
  trackingId          String?
  trackingUrl         String?
  shippedAt           DateTime?
  deliveredAt         DateTime?

  // Relations
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id])
  seller              Seller            @relation(fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int      // 1-5
  title     String?
  comment   String?
  images    String[]
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // One review per user per product
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}
